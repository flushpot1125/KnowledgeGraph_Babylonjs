{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist-server"
  },
  "include": ["server.ts", "graph.ts", "keyword.ts", "timeline.ts", "neo4j.ts"],
  "exclude": ["node_modules", "dist", "src"]
}
